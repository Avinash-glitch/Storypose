# Copy this file to .env and fill in your real values.
# Do not commit .env. It contains private credentials.

# Required for /generate-image in server.py.
# Get this from fal.ai dashboard/account API keys.
FAL_KEY=your_fal_key_here
FAL_MODEL_ID=fal-ai/flux/schnell
IMAGE_BACKEND=fal

# Optional but recommended for better story gap/follow-up questions.
# If omitted or invalid, server.py falls back to the built-in heuristic.
ANTHROPIC_API_KEY=your_anthropic_key_here
CLAUDE_MODEL=claude-3-sonnet-20241022

# Optional storybook PDF output folder for storybook_pipeline.py.
# Defaults to the current working directory if not set.
STORYBOOK_OUTPUT_DIR=./

# ComfyUI integration (used when IMAGE_BACKEND=comfy)
COMFY_API_URL=http://127.0.0.1:8188
COMFY_WORKFLOW_PATH=/Users/avinashkannan/ComfyUI/user/default/workflows/storypose.json
COMFY_POSITIVE_NODE_ID=5
COMFY_NEGATIVE_NODE_ID=9
COMFY_SAVE_NODE_ID=7

# Legacy/local LLM settings. These are currently defined in server.py but not
# used by the active detect_story_gaps implementation.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional local Stable Diffusion test script path.
# Not used by the FastAPI app's /generate-image route.
SD_MODEL_PATH=/path/to/model.safetensors
